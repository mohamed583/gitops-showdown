[4.635, "o", "=== clusters ===============================================\r\n  mycluster\r\n  showdown-argocd\r\n  showdown-flux\r\n\r\n=== git remote =============================================\r\n  Gitea    running at http://gitea.showdown.local:3000/showdown/gitops-showdown.git (ip 172.19.0.6)\r\n  browse   http://localhost:3300/showdown/gitops-showdown\r\n\r\n=== showdown-argocd / Argo CD v3.5.3 ===========\r\nNAME         SYNC STATUS   HEALTH STATUS\r\nshowdown     Synced        Healthy\r\nticketflow   Synced        Healthy\r\nNAME                         READY   UP-TO-DATE   AVAILABLE   AGE\r\ndeployment.apps/ticketflow   1/1     1            1           43m\r\n\r\nNAME                                   READY   AGE\r\nstatefulset.apps/ticketflow-postgres   1/1     43m\r\n\r\n=== showdown-flux / Flux v2.9.5 ==================\r\nNAME         AGE   READY   STATUS\r\nticketflow   43m   True    Helm upgrade succeeded for release ticketflow/ticketflow.v5 with chart ticketflow@0.1.0+2cb8a01c62ab.2\r\nNAME                         READY   UP-TO-DATE   AVAILABLE   AGE\r\ndeployment.apps/ticketflow   1/1     1            1           43m\r\n\r\nNAME                                   READY   AGE\r\nstatefulset.apps/ticketflow-postgres   1/1     43m\r\n"]
[9.435, "o", "\r\n"]
[9.435, "o", "\u001b[36m# Both engines serve the same commit. So what actually differs?\u001b[0m\r\n"]
