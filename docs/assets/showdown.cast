[0.0, "o", "\u001b[2J\u001b[H"]
[0.0, "o", "\r\n  \u001b[1mgitops-showdown\u001b[0m  \u001b[2mArgo CD v3.5.3 vs Flux v2.9.5 on Kubernetes v1.36.4\u001b[0m\r\n\r\n"]
[2.2, "o", "\u001b[36m# One application. Two GitOps engines. One identical Helm chart.\u001b[0m\r\n"]
