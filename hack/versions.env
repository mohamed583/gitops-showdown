# hack/versions.env -- single source of truth for every pinned version.
#
# Consumed by:
#   - Makefile           via `include hack/versions.env`
#   - hack/*.sh          via `source hack/versions.env`
#   - .github/workflows/ via `cat hack/versions.env >> $GITHUB_ENV`
#
# FORMAT CONSTRAINT: plain KEY=value, literal values only, no quoting, no
# variable references. This file is parsed by GNU Make *and* by Bash, and
# `$(FOO)` means expansion in one and command substitution in the other.
# If you need a derived value, derive it in the consumer, not here.
#
# Verified against upstream release pages on 2026-09-15 (see docs/adr/001).

# --- GitOps engines -------------------------------------------------------
# Argo CD 3.5 tested matrix: Kubernetes v1.33, v1.34, v1.35, v1.36
# https://github.com/argoproj/argo-cd/blob/v3.5.3/docs/operator-manual/tested-kubernetes-versions.md
ARGOCD_VERSION=v3.5.3

# Flux 2.9.5 requirement: v1.33 >= 1.33.0 | v1.34 >= 1.34.1 | v1.35+ >= 1.35.0
# https://fluxcd.io/flux/installation/#prerequisites
FLUX_VERSION=v2.9.5

# --- Cluster substrate ----------------------------------------------------
# kind v0.33.0 ships v1.37.0 as its DEFAULT node image. v1.37 is outside the
# Argo CD 3.5 tested matrix, so the default is not usable here. The newest
# version inside BOTH support windows is v1.36 -- pinned by digest below.
KIND_VERSION=v0.33.0
K8S_VERSION=v1.36.4
KIND_NODE_IMAGE=kindest/node:v1.36.4@sha256:099e049362a1526b2db71494e1947aae99bd16290d7c895f2b7ea312e3cbfaed

# --- Pinned install manifests --------------------------------------------
# Both engines are installed the same way: kubectl apply of an immutable,
# version-tagged upstream manifest. Neither engine gets a privileged install
# path, and neither CLI is required to bring a cluster up.
ARGOCD_MANIFEST=https://raw.githubusercontent.com/argoproj/argo-cd/v3.5.3/manifests/install.yaml
FLUX_MANIFEST=https://github.com/fluxcd/flux2/releases/download/v2.9.5/install.yaml

# --- Identifiers (not versions, but must not be spelled twice) -----------
CLUSTER_ARGOCD=showdown-argocd
CLUSTER_FLUX=showdown-flux
ARGOCD_NAMESPACE=argocd
FLUX_NAMESPACE=flux-system

# --- Minimum host tool versions enforced by hack/preflight.sh ------------
MIN_DOCKER_VERSION=24.0.0
MIN_KIND_VERSION=0.33.0
MIN_KUBECTL_VERSION=1.33.0

# --- ticketflow (session 2) ----------------------------------------------
TICKETFLOW_VERSION=0.1.0
TICKETFLOW_IMAGE=ticketflow
PYTHON_IMAGE=python:3.13-slim@sha256:9d2e5553305c7c7b0097999bb17187c69b921ccd6bc9d40e4bb5ebe652c00285
POSTGRES_IMAGE=postgres:18-alpine@sha256:d3e1620b530c944afa6e887d22eb899824da68e19c52024bf98f5220c88a65b2

# --- Helm ------------------------------------------------------------------
# Both engines run Helm 4.2.x internally, read from the running pods:
#   argocd-repo-server 3.5.3 bundles helm v4.2.1
#   helm-controller v1.6.4 (Flux 2.9.5) links helm.sh/helm/v4 v4.2.4
# A local `helm template` should not run ahead of what the engines execute.
MIN_HELM_VERSION=4.2.0
ARGOCD_HELM_VERSION=4.2.1
FLUX_HELM_VERSION=4.2.4
